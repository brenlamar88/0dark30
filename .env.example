# Alpaca paper account keys (free): https://app.alpaca.markets -> Paper trading -> API keys.
# Phase 1 uses market data only; no orders are ever placed by this codebase.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Optional - LLM analyst layer (rationale + hazard flags on the brief).
# The brief degrades gracefully without it.
ANTHROPIC_API_KEY=

# Optional - earnings calendar for single-name symbols (free tier: https://finnhub.io).
# The ETF-only starting universe does not need it; a hasEarnings symbol without
# it is blocked by design (unknown catalyst != no catalyst).
FINNHUB_API_KEY=

# Optional - mirror the journal to Supabase (apply supabase/migrations first).
# JOURNAL_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
